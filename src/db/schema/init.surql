DEFINE TABLE users SCHEMAFULL;
DEFINE FIELD chatId ON TABLE users TYPE string;
DEFINE FIELD phoneNumber ON TABLE users TYPE option<string>;
DEFINE FIELD createdAt ON TABLE users TYPE string;
DEFINE FIELD updatedAt ON TABLE users TYPE string;
DEFINE INDEX users_chat_id ON TABLE users COLUMNS chatId UNIQUE;

DEFINE TABLE wa_sessions SCHEMAFULL;
DEFINE FIELD sessionId ON TABLE wa_sessions TYPE string;
DEFINE FIELD creds ON TABLE wa_sessions TYPE object FLEXIBLE;
DEFINE FIELD keys ON TABLE wa_sessions TYPE object FLEXIBLE;
DEFINE FIELD status ON TABLE wa_sessions TYPE object;
DEFINE FIELD updatedAt ON TABLE wa_sessions TYPE string;
DEFINE INDEX wa_sessions_session_id ON TABLE wa_sessions COLUMNS sessionId UNIQUE;

DEFINE TABLE messages SCHEMAFULL;
DEFINE FIELD userId ON TABLE messages TYPE string;
DEFINE FIELD chatId ON TABLE messages TYPE string;
DEFINE FIELD direction ON TABLE messages TYPE string;
DEFINE FIELD text ON TABLE messages TYPE string;
DEFINE FIELD attachmentIds ON TABLE messages TYPE array<string>;
DEFINE FIELD createdAt ON TABLE messages TYPE string;
DEFINE INDEX messages_chat_created ON TABLE messages COLUMNS chatId, createdAt;

DEFINE TABLE attachments SCHEMAFULL;
DEFINE FIELD userId ON TABLE attachments TYPE string;
DEFINE FIELD chatId ON TABLE attachments TYPE string;
DEFINE FIELD filename ON TABLE attachments TYPE option<string>;
DEFINE FIELD mimeType ON TABLE attachments TYPE string;
DEFINE FIELD kind ON TABLE attachments TYPE string;
DEFINE FIELD storagePath ON TABLE attachments TYPE string;
DEFINE FIELD sha256 ON TABLE attachments TYPE string;
DEFINE FIELD textContent ON TABLE attachments TYPE option<string>;
DEFINE FIELD ocrStatus ON TABLE attachments TYPE string;
DEFINE FIELD createdAt ON TABLE attachments TYPE string;
DEFINE INDEX attachments_sha256 ON TABLE attachments COLUMNS sha256 UNIQUE;

DEFINE TABLE resume_documents SCHEMAFULL;
