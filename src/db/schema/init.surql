DEFINE FIELD createdAt ON TABLE job_matches TYPE string;
DEFINE FIELD updatedAt ON TABLE job_matches TYPE string;
DEFINE INDEX job_matches_user_job ON TABLE job_matches COLUMNS userId, jobId UNIQUE;

