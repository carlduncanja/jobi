DEFINE FIELD salary ON TABLE job_postings TYPE option<string>;
DEFINE FIELD summary ON TABLE job_postings TYPE string;
DEFINE FIELD description ON TABLE job_postings TYPE option<string>;
DEFINE FIELD source ON TABLE job_postings TYPE string;
DEFINE FIELD publishedAt ON TABLE job_postings TYPE option<string>;
DEFINE FIELD tags ON TABLE job_postings TYPE array<string>;
DEFINE FIELD updatedAt ON TABLE job_postings TYPE string;
DEFINE INDEX job_postings_canonical_url ON TABLE job_postings COLUMNS canonicalUrl UNIQUE;

DEFINE TABLE job_matches SCHEMAFULL;
DEFINE FIELD userId ON TABLE job_matches TYPE string;
DEFINE FIELD jobId ON TABLE job_matches TYPE string;
DEFINE FIELD score ON TABLE job_matches TYPE number;
DEFINE FIELD reasons ON TABLE job_matches TYPE array<string>;
