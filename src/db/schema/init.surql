DEFINE FIELD summary ON TABLE search_profiles TYPE string;
DEFINE FIELD targetTitles ON TABLE search_profiles TYPE array<string>;
DEFINE FIELD relatedTitles ON TABLE search_profiles TYPE array<string>;
DEFINE FIELD skills ON TABLE search_profiles TYPE array<string>;
DEFINE FIELD preferredLocations ON TABLE search_profiles TYPE array<string>;
DEFINE FIELD remotePreference ON TABLE search_profiles TYPE option<string>;
DEFINE FIELD excludedKeywords ON TABLE search_profiles TYPE array<string>;
