DEFINE FIELD titles ON TABLE resume_profiles TYPE array<string>;
DEFINE FIELD skills ON TABLE resume_profiles TYPE array<string>;
DEFINE FIELD preferredLocations ON TABLE resume_profiles TYPE array<string>;
