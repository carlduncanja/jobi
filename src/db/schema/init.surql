DEFINE FIELD source ON TABLE resume_documents TYPE string;
DEFINE FIELD rawText ON TABLE resume_documents TYPE string;
DEFINE FIELD extractedAt ON TABLE resume_documents TYPE string;
DEFINE FIELD updatedAt ON TABLE resume_documents TYPE string;

