DEFINE FIELD rawText ON TABLE resume_profiles TYPE string;
DEFINE FIELD sourceAttachmentIds ON TABLE resume_profiles TYPE array<string>;
DEFINE FIELD updatedAt ON TABLE resume_profiles TYPE string;
DEFINE INDEX resume_profiles_user_id ON TABLE resume_profiles COLUMNS userId UNIQUE;

DEFINE TABLE search_profiles SCHEMAFULL;
